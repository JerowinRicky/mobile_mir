# ==============================================================================
# SECURE ANDROID REMOTE CONTROL PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure strong secrets before deployment.
# NEVER commit the actual .env file with secrets into source control.

# --- DJANGO CONFIGURATION ---
DJANGO_SECRET_KEY=generate-a-strong-random-64-char-secret-key-here
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com,localhost,127.0.0.1,nginx,backend

# --- DATABASE CONFIGURATION (PostgreSQL) ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=remotedevice_db
DB_USER=remotedevice_user
DB_PASSWORD=generate-a-strong-postgres-password-here

# --- CACHE & CHANNELS CONFIGURATION (Redis) ---
REDIS_HOST=redis
REDis_PORT=6379
REDIS_PASSWORD=generate-a-strong-redis-password-here

# --- JWT AUTHENTICATION CONFIGURATION ---
JWT_SIGNING_KEY=generate-a-strong-jwt-signing-secret-here
JWT_ACCESS_TTL=900        # 15 minutes (short-lived access tokens)
JWT_REFRESH_TTL=604800    # 7 days (refresh tokens with rotation)

# --- COTURN STUN/TURN CONFIGURATION ---
COTURN_STUN_SERVER=stun:yourdomain.com:3478
COTURN_TURN_SERVER=turn:yourdomain.com:3478
COTURN_AUTH_SECRET=generate-a-strong-coturn-shared-secret-here
COTURN_REALM=yourdomain.com

# --- SECURITY / AUDIT CONFIGURATION ---
PIN_EXPIRY_SECONDS=180    # 3 minutes temporary PIN lifetime
PIN_MAX_ATTEMPTS=3        # 3 attempts before device lockout
SESSION_TTL_SECONDS=3600  # 1 hour maximum active session duration
ENFORCE_SSL=True
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://localhost
